{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Copilot analysis v1.2",
  "type": "object",
  "required": [
    "schema_version",
    "detector",
    "coordinate_order",
    "metric_crs",
    "distance_axis",
    "curvature_unit",
    "positive_curvature",
    "route_length_m",
    "actual_spacing_m",
    "config",
    "quality",
    "metadata",
    "bend_count",
    "bends"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "detector": {
      "const": "gaussian_heading_hysteresis"
    },
    "coordinate_order": {
      "const": "longitude,latitude"
    },
    "metric_crs": {
      "type": "string"
    },
    "distance_axis": {
      "const": "original_projected_route_arclength_m"
    },
    "curvature_unit": {
      "const": "1/m"
    },
    "positive_curvature": {
      "const": "left_relative_to_travel"
    },
    "route_length_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "actual_spacing_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "bend_count": {
      "type": "integer",
      "minimum": 0
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spacing_m",
        "smoothing_m",
        "polyorder",
        "radius_threshold_m",
        "min_length_m",
        "merge_gap_m",
        "min_turn_deg",
        "circle_span_m",
        "detection_sigma_m",
        "heading_transition_cap_m",
        "release_ratio",
        "opposite_tolerance_deg"
      ],
      "properties": {
        "spacing_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "smoothing_m": {
          "type": "number",
          "minimum": 0
        },
        "polyorder": {
          "type": "integer",
          "minimum": 2
        },
        "radius_threshold_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min_length_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "merge_gap_m": {
          "type": "number",
          "minimum": 0
        },
        "min_turn_deg": {
          "type": "number",
          "minimum": 0
        },
        "circle_span_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "detection_sigma_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "heading_transition_cap_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "release_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "opposite_tolerance_deg": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "quality": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    },
    "bends": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bend"
      }
    },
    "speed": {
      "$ref": "#/$defs/speed"
    }
  },
  "$defs": {
    "lonlat": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ]
    },
    "bend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start_s_m",
        "end_s_m",
        "direction",
        "min_radius_m",
        "p50_radius_m",
        "length_m",
        "turn_angle_deg",
        "apex_s_m",
        "start_index",
        "end_index",
        "apex_index",
        "source_vertex_count",
        "source_max_segment_m",
        "geometry_support"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "start_s_m": {
          "type": "number",
          "minimum": 0
        },
        "end_s_m": {
          "type": "number",
          "minimum": 0
        },
        "direction": {
          "enum": [
            "left",
            "right"
          ]
        },
        "min_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p50_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "length_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "turn_angle_deg": {
          "type": "number"
        },
        "apex_s_m": {
          "type": "number",
          "minimum": 0
        },
        "start_index": {
          "type": "integer",
          "minimum": 0
        },
        "end_index": {
          "type": "integer",
          "minimum": 1
        },
        "apex_index": {
          "type": "integer",
          "minimum": 0
        },
        "merged_part_count": {
          "type": "integer",
          "minimum": 1
        },
        "detection_min_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source_vertex_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_max_segment_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "geometry_support": {
          "enum": [
            "sparse",
            "multi_vertex"
          ]
        },
        "start_lonlat": {
          "$ref": "#/$defs/lonlat"
        },
        "end_lonlat": {
          "$ref": "#/$defs/lonlat"
        },
        "apex_lonlat": {
          "$ref": "#/$defs/lonlat"
        }
      }
    },
    "speed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "config",
        "notes",
        "slowdown_bend_count",
        "series_count",
        "multi_bend_series_count",
        "low_confidence_slowdown_count",
        "series",
        "bends"
      ],
      "properties": {
        "model": {
          "const": "point_mass_aashto_side_friction"
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approach_speed_kmh",
            "superelevation",
            "friction_scale",
            "reaction_time_s",
            "deceleration_mps2",
            "warning_margin_kmh",
            "core_fraction",
            "lane_slack_m",
            "min_circle_vertices",
            "acceleration_mps2",
            "overspeed_tolerance_kmh",
            "alert_cooldown_s",
            "envelope_spacing_m"
          ],
          "properties": {
            "approach_speed_kmh": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "superelevation": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.12
            },
            "friction_scale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "reaction_time_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "deceleration_mps2": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "warning_margin_kmh": {
              "type": "number",
              "minimum": 0
            },
            "core_fraction": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "lane_slack_m": {
              "type": "number",
              "minimum": 0
            },
            "min_circle_vertices": {
              "type": "integer",
              "minimum": 3
            },
            "acceleration_mps2": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "overspeed_tolerance_kmh": {
              "type": "number",
              "minimum": 0
            },
            "alert_cooldown_s": {
              "type": "number",
              "minimum": 0
            },
            "envelope_spacing_m": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bend_speed"
          }
        },
        "slowdown_bend_count": {
          "type": "integer",
          "minimum": 0
        },
        "series_count": {
          "type": "integer",
          "minimum": 0
        },
        "multi_bend_series_count": {
          "type": "integer",
          "minimum": 0
        },
        "low_confidence_slowdown_count": {
          "type": "integer",
          "minimum": 0
        },
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/speed_series"
          }
        }
      }
    },
    "bend_speed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bend_id",
        "direction",
        "radius_m",
        "heading_core_radius_m",
        "circle_fit_radius_m",
        "core_start_s_m",
        "core_end_s_m",
        "core_turn_deg",
        "core_source_vertex_count",
        "lane_slack_radius_m",
        "radius_basis",
        "confidence",
        "target_speed_kmh",
        "speed_reduction_kmh",
        "requires_slowdown",
        "series_id",
        "target_is_unbounded"
      ],
      "properties": {
        "bend_id": {
          "type": "integer",
          "minimum": 1
        },
        "direction": {
          "enum": [
            "left",
            "right"
          ]
        },
        "radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "heading_core_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "circle_fit_radius_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "core_start_s_m": {
          "type": "number",
          "minimum": 0
        },
        "core_end_s_m": {
          "type": "number",
          "minimum": 0
        },
        "core_turn_deg": {
          "type": "number"
        },
        "core_source_vertex_count": {
          "type": "integer",
          "minimum": 0
        },
        "lane_slack_radius_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "radius_basis": {
          "enum": [
            "heading_core",
            "min(heading_core, circle_fit)",
            "lane_slack"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "target_speed_kmh": {
          "type": "number",
          "minimum": 0
        },
        "speed_reduction_kmh": {
          "type": "number",
          "minimum": 0
        },
        "requires_slowdown": {
          "type": "boolean"
        },
        "series_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "target_is_unbounded": {
          "type": "boolean"
        }
      }
    },
    "speed_series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "bend_ids",
        "critical_bend_id",
        "min_target_kmh",
        "first_core_start_s_m",
        "last_core_end_s_m",
        "slowdown_start_s_m",
        "trigger_s_at_approach_m",
        "trigger_clipped_to_route_start",
        "message",
        "envelope"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "bend_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "critical_bend_id": {
          "type": "integer",
          "minimum": 1
        },
        "min_target_kmh": {
          "type": "number",
          "minimum": 0
        },
        "first_core_start_s_m": {
          "type": "number",
          "minimum": 0
        },
        "last_core_end_s_m": {
          "type": "number",
          "minimum": 0
        },
        "slowdown_start_s_m": {
          "type": "number",
          "minimum": 0
        },
        "trigger_s_at_approach_m": {
          "type": "number",
          "minimum": 0
        },
        "trigger_clipped_to_route_start": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        },
        "envelope": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "trigger_lonlat": {
          "$ref": "#/$defs/lonlat"
        }
      }
    }
  }
}